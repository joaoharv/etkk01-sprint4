    {
      "id": 31,
      "type": "table",
      "title": "Variação mês a mês (últimos 2 meses completos)",
      "description": "Compara os totais dos 2 últimos meses completos do dataset -- não ajustado sazonalmente. Ambos os meses já pertencem ao regime de volume vigente (pós ago/set-2025, ver periodo_pos_set_2025 em src/ml/features/volume_features.py); não é uma comparação através da mudança estrutural de volume documentada no projeto, que tornaria o percentual enganoso se um dos meses fosse de 2023/2024.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH meses AS (SELECT date_trunc('month', data_abertura)::date AS mes, sum(total_incidentes) AS total FROM gold.incidentes_diario_total GROUP BY 1) SELECT (SELECT mes FROM meses ORDER BY mes DESC LIMIT 1) AS \"Mês atual\", (SELECT total FROM meses ORDER BY mes DESC LIMIT 1) AS \"Incidentes (mês atual)\", (SELECT mes FROM meses ORDER BY mes DESC OFFSET 1 LIMIT 1) AS \"Mês anterior\", (SELECT total FROM meses ORDER BY mes DESC OFFSET 1 LIMIT 1) AS \"Incidentes (mês anterior)\", round(100.0 * ((SELECT total FROM meses ORDER BY mes DESC LIMIT 1) - (SELECT total FROM meses ORDER BY mes DESC OFFSET 1 LIMIT 1)) / NULLIF((SELECT total FROM meses ORDER BY mes DESC OFFSET 1 LIMIT 1), 0), 1) AS \"Variação %\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": []
      },
