          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT to_char(date_trunc('month', data_abertura),'YYYY-MM') AS mes, sum(total_incidentes) AS total FROM gold.incidentes_diario_total WHERE $__timeFilter(data_abertura) GROUP BY 1 ORDER BY 1"
