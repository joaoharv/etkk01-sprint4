    {
      "id": 10,
      "type": "stat",
      "title": "F1-Macro (OOS: VAL+TEST)",
      "description": "Calculado exclusivamente sobre gold.previsoes_prioridade, que so contem VAL+TEST -- TRAIN nunca entra aqui (ver src/ml/predict_prioridade.py).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH base AS (SELECT prioridade_real, prioridade_prevista FROM gold.previsoes_prioridade), por_classe AS (SELECT classe, (SELECT COUNT(*) FROM base WHERE prioridade_real = classe AND prioridade_prevista = classe) AS tp, (SELECT COUNT(*) FROM base WHERE prioridade_real = classe) AS total_real, (SELECT COUNT(*) FROM base WHERE prioridade_prevista = classe) AS total_prev FROM (VALUES ('2 - Alta'), ('3 - Média'), ('4 - Baixa')) AS c(classe)) SELECT round(avg(CASE WHEN (tp::numeric/NULLIF(total_real,0) + tp::numeric/NULLIF(total_prev,0)) = 0 THEN 0 ELSE 2 * (tp::numeric/NULLIF(total_real,0)) * (tp::numeric/NULLIF(total_prev,0)) / (tp::numeric/NULLIF(total_real,0) + tp::numeric/NULLIF(total_prev,0)) END)::numeric, 3) AS f1_macro FROM por_classe"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "color": {
            "mode": "fixed",
            "fixedColor": "#EB6A7C"
          },
          "decimals": 3,
          "thresholds": {
