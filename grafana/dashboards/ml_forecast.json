    {
      "id": 5,
      "type": "table",
      "title": "Real × Previsto (histórico avaliado) — D+1 e D+7",
      "description": "LEFT JOIN por data_alvo -- previsao futura sem valor real ainda aparece como 'aguardando real', nunca some da tabela.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE p.horizonte WHEN 'D+1' THEN 'D+1 (Persistência)' WHEN 'D+7' THEN 'D+7 (Ridge)' END AS \"Horizonte\", p.data_referencia AS \"Data de referência\", p.data_alvo AS \"Data alvo\", p.valor_previsto AS \"Previsto\", g.volume_total AS \"Real\", CASE WHEN g.volume_total IS NULL THEN NULL ELSE round(abs(p.valor_previsto - g.volume_total)::numeric, 1) END AS \"Erro absoluto\" FROM gold.previsoes p LEFT JOIN gold.ml_volume_diario g ON g.data_abertura = p.data_alvo WHERE p.serie = 'total' AND $__timeFilter(p.data_alvo) ORDER BY p.horizonte, p.data_alvo"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Real"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "aguardando real"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Erro absoluto"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "aguardando real"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
