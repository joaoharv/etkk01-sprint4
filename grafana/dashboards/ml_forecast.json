    {
      "id": 6,
      "type": "table",
      "title": "MAE / RMSE por horizonte",
      "description": "Calculado SOMENTE sobre dias com valor real conhecido (JOIN, nao LEFT JOIN) -- a linha forward nunca entra nessa media.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE p.horizonte WHEN 'D+1' THEN 'D+1 (Persistência)' WHEN 'D+7' THEN 'D+7 (Ridge)' END AS \"Horizonte\", round(avg(abs(p.valor_previsto - g.volume_total))::numeric, 2) AS \"MAE\", round(sqrt(avg(power(p.valor_previsto - g.volume_total, 2)))::numeric, 2) AS \"RMSE\", count(*) AS \"Dias avaliados\" FROM gold.previsoes p JOIN gold.ml_volume_diario g ON g.data_abertura = p.data_alvo WHERE p.serie = 'total' GROUP BY p.horizonte ORDER BY \"Horizonte\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MAE"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RMSE"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
