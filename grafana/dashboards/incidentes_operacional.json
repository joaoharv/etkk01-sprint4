    {
      "id": 15,
      "type": "table",
      "title": "Dias de pico — composição por prioridade (Top 10)",
      "description": "Mostra a DISTRIBUIÇÃO/CONCENTRAÇÃO de prioridade nos dias de maior volume -- não indica causa do pico (associação, não causalidade). P1 e P5 omitidos por serem estatisticamente irrelevantes (1 e 333 registros em todo o histórico).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.data_abertura AS \"Data\", t.total_incidentes AS \"Incidentes\", COALESCE(SUM(p.total_incidentes) FILTER (WHERE p.prioridade = '2 - Alta'), 0) AS \"P2 Alta\", COALESCE(SUM(p.total_incidentes) FILTER (WHERE p.prioridade = '3 - Média'), 0) AS \"P3 Média\", COALESCE(SUM(p.total_incidentes) FILTER (WHERE p.prioridade = '4 - Baixa'), 0) AS \"P4 Baixa\" FROM gold.incidentes_diario_total t LEFT JOIN gold.incidentes_diario_prioridade p ON p.data_abertura = t.data_abertura WHERE $__timeFilter(t.data_abertura) GROUP BY t.data_abertura, t.total_incidentes ORDER BY t.total_incidentes DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
