    {
      "id": 32,
      "type": "table",
      "title": "Top 15 categorias — Pareto (concentração acumulada)",
      "description": "Evoluído de barchart simples para tabela de Pareto na evolução BI: mostra % do total e % acumulado por categoria, reaproveitando gold.incidentes_diario_categoria (mesma fonte de antes). Achado relevante: 'Não informado' sozinho concentra ~63% do volume -- não é uma categoria operacional, é uma lacuna de categorização na origem dos dados.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH base AS (SELECT categoria, sum(total_incidentes) AS total FROM gold.incidentes_diario_categoria WHERE $__timeFilter(data_abertura) GROUP BY 1), ranked AS (SELECT categoria, total, sum(total) OVER (ORDER BY total DESC) AS acumulado, sum(total) OVER () AS total_geral FROM base) SELECT categoria AS \"Categoria\", total AS \"Incidentes\", round(100.0*total/total_geral, 1) AS \"% do total\", round(100.0*acumulado/total_geral, 1) AS \"% acumulado\" FROM ranked ORDER BY total DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
