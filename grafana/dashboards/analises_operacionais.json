    {
      "id": 43,
      "type": "table",
      "title": "Grupo designado × Prioridade",
      "description": "Cruzamento simples e rastreável (silver.incidentes_tratados, contagem condicional por prioridade) -- mostra ASSOCIAÇÃO/CONCENTRAÇÃO de prioridade dentro de cada grupo, não causa. P1 e P5 omitidos por serem estatisticamente irrelevantes (1 e 333 registros em todo o histórico). Achado: Team11 concentra quase toda sua carga em P3-Média (~93%), um padrão bem diferente do Team14.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT grupo_designado AS \"Grupo\", count(*) FILTER (WHERE prioridade = '2 - Alta') AS \"P2 Alta\", count(*) FILTER (WHERE prioridade = '3 - Média') AS \"P3 Média\", count(*) FILTER (WHERE prioridade = '4 - Baixa') AS \"P4 Baixa\", count(*) AS \"Total\" FROM silver.incidentes_tratados WHERE $__timeFilter(data_abertura) GROUP BY 1 ORDER BY 5 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
