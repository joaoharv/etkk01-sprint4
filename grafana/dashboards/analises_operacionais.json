    {
      "id": 37,
      "type": "timeseries",
      "title": "Duração de resolução: oficial (média) vs. robusta (mediana / média aparada P99)",
      "description": "Movido do Dashboard 01 (Etapa A) -- conteúdo de diagnóstico analítico, não pertence à primeira camada executiva. duracao_media_segundos é o KPI OFICIAL (gold.kpi_resumo), inalterado. As séries robustas usam a mesma população (duracao_valida=true) e existem só para quantificar o efeito da cauda extrema ao lado do oficial — nunca o substituem.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "incidentes_ti"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "incidentes_ti"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT data_abertura AS time, round(duracao_media_segundos/3600.0,2) AS \"Oficial (média)\", round(duracao_mediana_segundos/3600.0,2) AS \"Robusta (mediana)\", round(duracao_media_aparada_p99_segundos/3600.0,2) AS \"Robusta (média aparada P99)\" FROM gold.kpi_resumo WHERE $__timeFilter(data_abertura) ORDER BY 1"
        }
      ],
      "fieldConfig": {
