# ============================================================
# sprint4-incidentes-ti  —  variaveis de ambiente
# Copie para .env  ->  cp .env.example .env
# O .env NAO deve ser versionado (ja esta no .gitignore).
# ============================================================

# ----- PostgreSQL -----
POSTGRES_USER=incidentes
POSTGRES_PASSWORD=incidentes_dev_pwd
POSTGRES_DB=incidentes_ti
# Porta exposta no host (o container sempre usa 5432 internamente)
POSTGRES_PORT_HOST=5432

# Consumido pela camada ETL (src/) para montar a engine SQLAlchemy.
# Dentro da rede Docker o host e sempre o nome do servico: "postgres".
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Arquivo de origem -----
# Caminho do Excel dentro do container do Airflow (volume montado).
SOURCE_FILE_PATH=/opt/airflow/project/data/LW-DATASET.xlsx

# ----- Apache Airflow -----
AIRFLOW_PORT_HOST=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Gere os proprios valores:
#   FERNET: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   SECRET: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_FERNET_KEY=troque-por-uma-fernet-key-valida
AIRFLOW_SECRET_KEY=troque-por-um-secret-hex-de-64-chars
# Conexao que a DAG usa para falar com o banco de negocio (schema gold/silver/bronze).
AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql://incidentes:incidentes_dev_pwd@postgres:5432/incidentes_ti

# ----- Grafana -----
GRAFANA_PORT_HOST=3000
GRAFANA_ADMIN_USER=admin
# Nao use "admin" aqui: o Grafana forca a troca de senha no 1o login se a senha for a padrao.
GRAFANA_ADMIN_PASSWORD=locaweb2024

# ----- Alertas por e-mail (Plano 2.1, Etapa 15) -----
# Mailpit CAPTURA os e-mails localmente -- nao ha envio real para a internet e
# nao ha credencial de SMTP real neste projeto. UI de inspecao: http://localhost:8025.
MAILPIT_UI_PORT_HOST=8025
MAILPIT_SMTP_PORT_HOST=1025
# Remetente/destinatarios sao so rotulos (Mailpit aceita qualquer endereco).
ALERTA_EMAIL_REMETENTE=alertas@sprint4.local
ALERTA_EMAIL_DESTINATARIOS=oncall@sprint4.local
